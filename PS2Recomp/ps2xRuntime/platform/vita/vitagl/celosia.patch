diff --git a/source/shared.h b/source/shared.h
index 167e4f2..91115eb 100644
--- a/source/shared.h
+++ b/source/shared.h
@@ -1024,6 +1024,56 @@ extern float fullscreen_y_scale;
 extern float fullscreen_z_scale;
 
 extern SceGxmContext *gxm_context; // sceGxm context instance
+
+// celosia: GXM state set only on a change (each draw set the vertex and
+// fragment programs and every fragment texture again: ~8% of the render
+// thread for ~1 500 draws a frame). Invalidated at each scene's start and
+// by any other path that sets them (vgl_raw_set_*).
+extern const SceGxmVertexProgram *vgl_cur_vprog;
+extern const SceGxmFragmentProgram *vgl_cur_fprog;
+extern uint32_t vgl_cur_ftex[16][4];
+extern uint32_t vgl_cur_ftex_valid;
+static inline __attribute__((always_inline)) void vgl_state_invalidate(void) {
+	vgl_cur_vprog = NULL;
+	vgl_cur_fprog = NULL;
+	vgl_cur_ftex_valid = 0;
+}
+static inline __attribute__((always_inline)) void vgl_set_vprog(const SceGxmVertexProgram *prog) {
+	if (vgl_cur_vprog != prog) {
+		vgl_cur_vprog = prog;
+		sceGxmSetVertexProgram(gxm_context, prog);
+	}
+}
+static inline __attribute__((always_inline)) void vgl_set_fprog(const SceGxmFragmentProgram *prog) {
+	if (vgl_cur_fprog != prog) {
+		vgl_cur_fprog = prog;
+		sceGxmSetFragmentProgram(gxm_context, prog);
+	}
+}
+static inline __attribute__((always_inline)) void vgl_set_ftex(int unit, const SceGxmTexture *tex) {
+	const uint32_t *w = (const uint32_t *)tex;
+	uint32_t *c = vgl_cur_ftex[unit & 15];
+	if (!(vgl_cur_ftex_valid & (1u << unit)) || c[0] != w[0] || c[1] != w[1] || c[2] != w[2] || c[3] != w[3]) {
+		c[0] = w[0];
+		c[1] = w[1];
+		c[2] = w[2];
+		c[3] = w[3];
+		vgl_cur_ftex_valid |= 1u << unit;
+		sceGxmSetFragmentTexture(gxm_context, unit, tex);
+	}
