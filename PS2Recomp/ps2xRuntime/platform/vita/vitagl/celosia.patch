+
+// Celosia: dst draws on src's depth and stencil (the same surface, so what
+// one scene leaves the next one tests against); both of one size. 0 for src:
+// dst back to a depth buffer of its own. GL_FALSE while src has none yet.
+GLboolean vglFramebufferShareDepth(GLuint dst, GLuint src) {
+	framebuffer *d = (framebuffer *)dst;
+	if (!d)
+		return GL_FALSE;
+	if (!src) {
+		if (d->depthbuffer_ptr && d->depthbuffer_ptr != &d->depthbuffer) {
+			d->depthbuffer_ptr = NULL;
+			d->depthbuffer_state = DEPTHBUFFER_MISSING;
+		}
+		return GL_TRUE;
+	}
+	framebuffer *s = (framebuffer *)src;
+	if (s->celo_scratch) // a scratch depth holds nothing to test against
+		return GL_FALSE;
+	if (!(s->depthbuffer_state & DEPTHBUFFER_READY) || !s->depthbuffer_ptr || s->width != d->width || s->height != d->height)
+		return GL_FALSE;
+	if (d->depthbuffer_ptr == s->depthbuffer_ptr)
+		return GL_TRUE;
+	if (d->depthbuffer_ptr == &d->depthbuffer)
+		mark_as_dirty(d->depthbuffer.depthData);
+	d->depthbuffer_ptr = s->depthbuffer_ptr;
+	d->depthbuffer_state = s->depthbuffer_state;
+	return GL_TRUE;
+}
+
+// Celosia r35: framebuffers whose draws never test depth or stencil (a copy,
+// a blur, a full-screen pass) still got a depth buffer of their own at their
+// first scene (one picture-sized DF32M each: ~1 MB at 512 x 448, 4 MB at 2x).
+// Flagged with vglFramebufferScratchDepth, they share one scratch depth
+// surface per size instead: its contents are never read by a test, so what
+// they draw is the same. vgl_celo_scratch_tested counts draws that would
+// break that (a depth or stencil test on such a framebuffer: should stay 0;
+// [vgl:dump] shows it). Not for a framebuffer whose depth another one
+// shares (vglFramebufferShareDepth refuses a scratch source).
+#define CELO_SCRATCH_SLOTS 12
+static struct {
+	int w, h;
+	GLboolean stencil;
+	uint32_t users;
+	SceGxmDepthStencilSurface surf;
+} celo_scratch_slot[CELO_SCRATCH_SLOTS];
+uint32_t vgl_celo_scratch_tested = 0, vgl_celo_scratch_bytes = 0, vgl_celo_scratch_users = 0;
+void vglFramebufferScratchDepth(GLuint id, GLboolean on) {
+	framebuffer *fb = (framebuffer *)id;
+	if (!fb)
+		return;
+	if (on) {
+		if (!fb->celo_scratch) {
+			// Its own depth (if it has one yet) goes; the scratch one is taken at its next scene.
+			if (fb->depthbuffer_ptr == &fb->depthbuffer)
+				mark_as_dirty(fb->depthbuffer.depthData);
+			if (fb->depthbuffer_ptr == &fb->depthbuffer || !fb->depthbuffer_ptr) {
+				fb->depthbuffer_ptr = NULL;
+				fb->depthbuffer_state &= ~DEPTHBUFFER_READY;
+			}
+			fb->celo_scratch = 1;
+		}
+	} else if (fb->celo_scratch) {
+		if (fb->celo_scratch >= 2 && fb->depthbuffer_ptr == &celo_scratch_slot[fb->celo_scratch - 2].surf) {
+			fb->depthbuffer_ptr = NULL;
+			fb->depthbuffer_state &= ~DEPTHBUFFER_READY;
+		}
+		vgl_celo_scratch_release(fb);
+		fb->celo_scratch = 0;
+	}
+}
+void vgl_celo_scratch_release(framebuffer *fb) {
+	if (fb->celo_scratch < 2)
+		return;
+	const int k = fb->celo_scratch - 2;
+	fb->celo_scratch = 1;
+	if (k < CELO_SCRATCH_SLOTS && celo_scratch_slot[k].users && --celo_scratch_slot[k].users == 0) {
+		mark_as_dirty(celo_scratch_slot[k].surf.depthData);
+		void *st = celo_scratch_slot[k].surf.stencilData;
+		if (st)
+			mark_as_dirty(st);
+		vgl_celo_scratch_bytes -= VGL_ALIGN(celo_scratch_slot[k].w, SCE_GXM_TILE_SIZEX) * VGL_ALIGN(celo_scratch_slot[k].h, SCE_GXM_TILE_SIZEY) * (celo_scratch_slot[k].stencil ? 5 : 4);
+		celo_scratch_slot[k].w = celo_scratch_slot[k].h = 0;
+	}
+	vgl_celo_scratch_users--;
+}
+// scene_reset, a scratch framebuffer without its depth: the slot of its size.
+void vgl_celo_scratch_take(framebuffer *fb) {
+	const GLboolean stencil = fb->depthbuffer_state == DEPTHBUFFER_WANTS_STENCIL;
+	vgl_celo_scratch_release(fb);
+	int k, free_k = -1;
+	for (k = 0; k < CELO_SCRATCH_SLOTS; k++) {
+		if (celo_scratch_slot[k].users && celo_scratch_slot[k].w == fb->width && celo_scratch_slot[k].h == fb->height && celo_scratch_slot[k].stencil == stencil)
+			break;
+		if (!celo_scratch_slot[k].users && free_k < 0)
+			free_k = k;
+	}
+	if (k == CELO_SCRATCH_SLOTS) {
+		if (free_k < 0) { // no slot: a depth of its own, as before
+			init_depth_stencil_buffer(fb->width, fb->height, &fb->depthbuffer, stencil);
+			fb->depthbuffer_ptr = &fb->depthbuffer;
+			fb->celo_scratch = 0;
+			return;
+		}
+		k = free_k;
+		init_depth_stencil_buffer(fb->width, fb->height, &celo_scratch_slot[k].surf, stencil);
+		celo_scratch_slot[k].w = fb->width;
+		celo_scratch_slot[k].h = fb->height;
+		celo_scratch_slot[k].stencil = stencil;
+		vgl_celo_scratch_bytes += VGL_ALIGN(fb->width, SCE_GXM_TILE_SIZEX) * VGL_ALIGN(fb->height, SCE_GXM_TILE_SIZEY) * (stencil ? 5 : 4);
+	}
+	celo_scratch_slot[k].users++;
+	vgl_celo_scratch_users++;
+	fb->celo_scratch = 2 + k;
+	fb->depthbuffer_ptr = &celo_scratch_slot[k].surf;
+}
+// A draw on a scratch framebuffer with a depth or stencil test (should not happen; counted).
+void vgl_celo_scratch_check(void) {
+	framebuffer *fb = active_write_fb;
+	if (!fb || !fb->celo_scratch || !(depth_test_state || stencil_test_state))
+		return;
+	if (fb->depthbuffer_ptr && fb->celo_scratch >= 2 && fb->depthbuffer_ptr != &celo_scratch_slot[fb->celo_scratch - 2].surf)
+		return; // on another framebuffer's depth (vglFramebufferShareDepth): its own tests
+	if (fb->depthbuffer_ptr && fb->celo_scratch == 1)
+		return;
+	vgl_celo_scratch_tested++;
+}
+// celosia r35: the framebuffers and their depth ([vgl:dump] fb lines).
+void vgl_celo_fb_dump(void) {
+	for (int i = 0; i < BUFFERS_NUM; i++) {
+		framebuffer *fb = &framebuffers[i];
+		if (!fb->active)
+			continue;
+		const char *kind = !fb->depthbuffer_ptr ? "none yet" : fb->depthbuffer_ptr == &fb->depthbuffer ? "own" : (fb->celo_scratch >= 2 && fb->depthbuffer_ptr == &celo_scratch_slot[fb->celo_scratch - 2].surf) ? "scratch" : "shared";
+		fprintf(stderr, "[vgl:dump]   fb %08x %dx%d depth %s, last scene %u frames ago\n", (unsigned)(uintptr_t)fb, fb->width, fb->height, kind,
+			fb->celo_frame ? (unsigned)(vgl_framecount - fb->celo_frame) : 0xFFFFFFFFu);
+	}
+}
+
+// Celosia r45: whether a scene loads its depth / stencil from memory at its
+// start (keep bit 0) and stores it at its end (bit 1). Built with
+// STORE_DEPTH_STENCIL (the GS renderer's targets keep their Z across the
+// scenes a frame splits them into), vitaGL forces both for every surface:
+// ~1.1 MB each way for a 512 x 448 scene with stencil, 2.6 MB for the
+// display's, whether or not the scene's draws need what was there or the
+// next scene reads what it leaves. Without the force GXM loads / stores
+// only for a partial render (the parameter buffer full), as vitaGL does
+// when built without it. -1: as built. fbo 0: the display. The scratch
+// depth surfaces (vglFramebufferScratchDepth: never tested) take
+// vglCeloScratchKeep's. Applied when a scene begins (vgl_celo_apply_keep).
+static int8_t celo_display_keep = -1, celo_scratch_keep = -1;
+uint32_t vgl_celo_scenes = 0, vgl_celo_depth_load = 0, vgl_celo_depth_store = 0; // since vglCeloSceneStats (KB)
+void vglCeloDepthKeep(GLuint fbo, int keep) {
+	if (keep < -1 || keep > 3)
+		keep = -1;
+	if (!fbo) {
+		celo_display_keep = (int8_t)keep;
+		return;
+	}
+	((framebuffer *)fbo)->celo_keep = (int8_t)keep;
+}
+void vglCeloScratchKeep(int keep) {
+	celo_scratch_keep = (int8_t)(keep < -1 || keep > 3 ? -1 : keep);
+}
+void vglCeloSceneStats(uint32_t *scenes, uint32_t *loadKB, uint32_t *storeKB) {
+	if (scenes)
+		*scenes = vgl_celo_scenes;
+	if (loadKB)
+		*loadKB = vgl_celo_depth_load;
+	if (storeKB)
+		*storeKB = vgl_celo_depth_store;
+	vgl_celo_scenes = vgl_celo_depth_load = vgl_celo_depth_store = 0;
+}
+void vgl_celo_apply_keep(framebuffer *fb, SceGxmDepthStencilSurface *surface, int w, int h) {
+	vgl_celo_scenes++;
+	if (!surface)
+		return;
+	int keep = fb ? fb->celo_keep : celo_display_keep;
+	if (keep < 0 && fb && fb->celo_scratch >= 2 && fb->celo_scratch - 2 < CELO_SCRATCH_SLOTS && surface == &celo_scratch_slot[fb->celo_scratch - 2].surf)
+		keep = celo_scratch_keep;
+	if (keep < 0) {
+#ifdef STORE_DEPTH_STENCIL
+		keep = 3;
+#else
+		keep = 0;
+#endif
+	}
+	sceGxmDepthStencilSurfaceSetForceLoadMode(surface, (keep & 1) ? SCE_GXM_DEPTH_STENCIL_FORCE_LOAD_ENABLED : SCE_GXM_DEPTH_STENCIL_FORCE_LOAD_DISABLED);
+	sceGxmDepthStencilSurfaceSetForceStoreMode(surface, (keep & 2) ? SCE_GXM_DEPTH_STENCIL_FORCE_STORE_ENABLED : SCE_GXM_DEPTH_STENCIL_FORCE_STORE_DISABLED);
+	const uint32_t kb = (uint32_t)(VGL_ALIGN(w, SCE_GXM_TILE_SIZEX) * VGL_ALIGN(h, SCE_GXM_TILE_SIZEY) * (surface->stencilData ? 5 : 4) / 1024);
+	if (keep & 1)
+		vgl_celo_depth_load += kb;
+	if (keep & 2)
+		vgl_celo_depth_store += kb;
+}
