+// Celosia: everything marked for deletion freed now, not 4 frames later.
+// Only after glFinish (the GPU idle): a renderer that remakes its render
+// targets at another size (a live resolution change) otherwise holds the old
+// and the new ones at once for 4 frames, which the Vita's memory may not.
+void vglCollectGarbageNow(void) {
+#ifndef HAVE_SINGLE_THREADED_GC
+	// The collector thread idle, nothing queued for it.
+	sceKernelWaitSema(gc_mutex[1], FRAME_PURGE_FREQ, NULL);
+#endif
+	for (int l = 0; l < FRAME_PURGE_FREQ; l++) {
+		for (int i = 0; i < FRAME_PURGE_LIST_SIZE; i++) {
+			if (!frame_purge_list[l][i])
+				break;
+			vgl_free(frame_purge_list[l][i]);
+			frame_purge_list[l][i] = NULL;
+		}
+		for (int i = 0; i < FRAME_PURGE_RENDERTARGETS_LIST_SIZE; i++) {
+			if (!frame_rt_purge_list[l][i])
+				break;
+			sceGxmDestroyRenderTarget(frame_rt_purge_list[l][i]);
+			frame_rt_purge_list[l][i] = NULL;
+		}
+	}
+	frame_elem_purge_idx = 0;
+	frame_rt_purge_idx = 0;
+#ifndef HAVE_SINGLE_THREADED_GC
+	sceKernelSignalSema(gc_mutex[1], FRAME_PURGE_FREQ);
+#endif
+}
