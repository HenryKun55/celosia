+				size_t home = celo_slot(celo_ptr[j]);
+				if (((j - home) & (CELO_SLOTS - 1)) >= ((j - hole) & (CELO_SLOTS - 1))) {
+					celo_ptr[hole] = celo_ptr[j];
+					celo_size[hole] = celo_size[j];
+					celo_type[hole] = celo_type[j];
+					celo_site_of[hole] = celo_site_of[j];
+					hole = j;
+				}
+			}
+			celo_ptr[hole] = 0;
+			break;
+		}
+		i = (i + 1) & (CELO_SLOTS - 1);
+		n++;
+	}
+	celo_release();
+	return type;
+}
+void *vgl_malloc(size_t size, vglMemType type) {
+	void *res = vgl_malloc_impl(size, type);
+	if (res && type < VGL_MEM_EXTERNAL)
+		celo_note(res, size, type);
+	return res;
+}
+void *vgl_calloc(size_t num, size_t size, vglMemType type) {
+	void *res = vgl_calloc_impl(num, size, type);
+	if (res && type < VGL_MEM_EXTERNAL)
+		celo_note(res, num * size, type);
+	return res;
+}
+void *vgl_memalign(size_t alignment, size_t size, vglMemType type) {
+	void *res = vgl_memalign_impl(alignment, size, type);
+	if (res && type < VGL_MEM_EXTERNAL)
+		celo_note(res, size, type);
+	return res;
+}
+void vgl_free(void *ptr) {
+	if (!ptr)
+		return;
+	if (celo_objects)
+		celo_forget(ptr);
+	vgl_free_impl(ptr);
+}
+void *vgl_realloc(void *ptr, size_t size) {
+	int type = ptr && celo_objects ? celo_forget(ptr) : -1;
+	void *res = vgl_realloc_impl(ptr, size);
+	if (res && type >= 0)
+		celo_note(res, size, type == CELO_SPILL ? CELO_SPILL : (int)vgl_mem_get_type_by_addr(res));
+	else if (!res && type >= 0)
+		celo_note(ptr, size, type); // (unchanged; the size as asked)
+	return res;
+}
+void vglCeloMemStats(size_t *used, size_t *spillBytes, size_t *spillCount, size_t *spillTotal, size_t *spillPeak) {
+	celo_acquire();
+	for (int i = 0; i < VGL_MEM_ALL; i++)
+		used[i] = i < VGL_MEM_EXTERNAL ? celo_used[i] : 0;
+	*spillBytes = celo_used[CELO_SPILL];
+	*spillCount = celo_spill_count;
+	*spillTotal = celo_spill_total;
+	*spillPeak = celo_spill_peak;
+	celo_release();
+}
+
+// celosia r35: what the pools hold, by who asked for it (the caller of
+// gpu_alloc_mapped_aligned_for_*, or of vgl_malloc / memalign), and the sizes
+// at each site; the circular vertex pool's use. One block of [vgl:dump] lines.
+uint32_t vgl_celo_circ_peak = 0, vgl_celo_circ_peak_all = 0, vgl_celo_circ_over_frames = 0;
+uint64_t vgl_celo_circ_over_bytes = 0;
+uint32_t vgl_celo_legacy_peak = 0;
+uint32_t vgl_celo_rt_count = 0, vgl_celo_rt_made = 0;
+uint64_t vgl_celo_rt_bytes = 0;
+static void *celo_rt_ptr[256];
+static uint32_t celo_rt_size[256];
+void vgl_celo_rt_note(void *rt, uint32_t size) {
+	for (int i = 0; i < 256; i++)
+		if (!celo_rt_ptr[i]) {
+			celo_rt_ptr[i] = rt;
+			celo_rt_size[i] = size;
+			return;
+		}
+}
+void vgl_celo_rt_forget(void *rt) {
+	for (int i = 0; i < 256; i++)
+		if (celo_rt_ptr[i] == rt) {
+			vgl_celo_rt_bytes -= celo_rt_size[i];
+			vgl_celo_rt_count--;
+			celo_rt_ptr[i] = NULL;
+			return;
+		}
+}
+extern uint32_t circular_data_pool_size;
+extern uint8_t gxm_display_buffer_count;
+void vglCeloMemDump(const char *tag) {
+	enum { SITES = 192, SIZES = 8 };
+	static struct { uintptr_t site; uint8_t type; uint32_t n; uint64_t bytes; uint32_t sz[SIZES], szn[SIZES]; } agg[SITES];
+	int nagg = 0;
+	uint32_t lostAgg = 0;
+	celo_acquire();
+	for (size_t i = 0; i < CELO_SLOTS; i++) {
+		if (!celo_ptr[i])
+			continue;
+		int k;
+		for (k = 0; k < nagg; k++)
+			if (agg[k].site == celo_site_of[i] && agg[k].type == celo_type[i])
+				break;
+		if (k == nagg) {
+			if (nagg == SITES) {
+				lostAgg++;
+				continue;
+			}
+			sceClibMemset(&agg[k], 0, sizeof(agg[k]));
+			agg[k].site = celo_site_of[i];
+			agg[k].type = celo_type[i];
+			nagg++;
+		}
+		agg[k].n++;
+		agg[k].bytes += celo_size[i];
+		int z;
+		for (z = 0; z < SIZES; z++)
+			if (agg[k].szn[z] == 0 || agg[k].sz[z] == celo_size[i])
+				break;
+		if (z < SIZES) {
+			agg[k].sz[z] = celo_size[i];
+			agg[k].szn[z]++;
+		}
+	}
+	celo_release();
+	// largest first
+	for (int a = 1; a < nagg; a++)
+		for (int b = a; b > 0 && agg[b].bytes > agg[b - 1].bytes; b--) {
+			__typeof__(agg[0]) t = agg[b];
+			agg[b] = agg[b - 1];
+			agg[b - 1] = t;
+		}
+	static const char *names[] = {"vram", "ram", "phycont", "budget", "ext", "heap"};
+	extern uint32_t vgl_celo_scratch_tested, vgl_celo_scratch_bytes, vgl_celo_scratch_users;
+	extern int legacy_pool_size;
+	fprintf(stderr, "[vgl:dump] %s: %d sites%s | circular pool %u KB x %u, peak %u KB (all %u KB), frames over %u (%u KB); immediate pool %u KB, used at most %u KB | render targets %u live (%u made), driver memory %u KB | scratch depth %u KB for %u framebuffers, draws on it with a depth / stencil test %u | dump base %p\n",
+		tag ? tag : "", nagg, lostAgg ? " (some not aggregated)" : "", (unsigned)(circular_data_pool_size / gxm_display_buffer_count / 1024), (unsigned)gxm_display_buffer_count,
+		(unsigned)(vgl_celo_circ_peak / 1024), (unsigned)(vgl_celo_circ_peak_all / 1024), (unsigned)vgl_celo_circ_over_frames, (unsigned)(vgl_celo_circ_over_bytes / 1024),
+		(unsigned)(legacy_pool_size / 1024), (unsigned)((vgl_celo_legacy_peak + 1023) / 1024),
+		(unsigned)vgl_celo_rt_count, (unsigned)vgl_celo_rt_made, (unsigned)(vgl_celo_rt_bytes / 1024),
+		(unsigned)(vgl_celo_scratch_bytes / 1024), (unsigned)vgl_celo_scratch_users, (unsigned)vgl_celo_scratch_tested, (void *)&vglCeloMemDump);
+	vgl_celo_circ_peak = 0;
+	extern void vgl_celo_fb_dump(void);
+	vgl_celo_fb_dump();
+	for (int k = 0; k < nagg; k++) {
+		if (agg[k].bytes < 64 * 1024 && k >= 24)
+			continue;
+		char sizes[256];
+		int o = 0;
+		for (int z = 0; z < SIZES && agg[k].szn[z]; z++)
+			o += snprintf(sizes + o, sizeof(sizes) - o, " %ux%u", (unsigned)agg[k].szn[z], (unsigned)agg[k].sz[z]);
+		fprintf(stderr, "[vgl:dump]   %-7s site %08x: %5u objects %8.2f MB |%s\n", agg[k].type <= VGL_MEM_ALL ? names[agg[k].type] : "?", (unsigned)agg[k].site,
+			(unsigned)agg[k].n, agg[k].bytes / 1048576.0, sizes);
+	}
+}
