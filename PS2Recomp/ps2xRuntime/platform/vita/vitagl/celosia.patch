+}
+static inline __attribute__((always_inline)) void vgl_raw_set_fprog(SceGxmContext *ctx, const SceGxmFragmentProgram *prog) {
+	vgl_cur_fprog = NULL;
+	sceGxmSetFragmentProgram(ctx, prog);
+}
+static inline __attribute__((always_inline)) int vgl_raw_set_ftex(SceGxmContext *ctx, unsigned int unit, const SceGxmTexture *tex) {
