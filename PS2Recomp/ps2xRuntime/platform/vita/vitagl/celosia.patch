+// celosia: what each GPU pool holds, and the GPU objects vitaGL had to put in
+// the newlib heap (gpu_utils' use_extra_mem fallback), for the port's
+// [vita:mem] line (vglCeloMemStats). Every pool allocation and every spill is
+// kept by pointer with its requested size (Vita3K's mspace usable sizes are 0).
+#define CELO_SLOTS 65536
+#define CELO_SPILL VGL_MEM_ALL
+static uintptr_t celo_ptr[CELO_SLOTS];
+static uint32_t celo_size[CELO_SLOTS];
+static uint8_t celo_type[CELO_SLOTS];
+static uintptr_t celo_site_of[CELO_SLOTS]; // celosia r35: who asked (vglCeloMemDump)
+void *vgl_celo_site = NULL; // set by gpu_alloc_mapped_aligned_for_* to their caller (outermost wins)
+static size_t celo_used[VGL_MEM_ALL + 1] = {};
+static size_t celo_objects = 0, celo_spill_count = 0, celo_spill_total = 0, celo_spill_peak = 0, celo_lost = 0;
+static volatile int celo_lock = 0;
+static inline void celo_acquire(void) { while (__sync_lock_test_and_set(&celo_lock, 1)) {} }
+static inline void celo_release(void) { __sync_lock_release(&celo_lock); }
+static inline size_t celo_slot(uintptr_t p) { return (size_t)((p >> 4) * 2654435761u) & (CELO_SLOTS - 1); }
+static void celo_note_at(void *ptr, size_t size, int type, void *site) {
+	if (!ptr)
+		return;
+	celo_acquire();
+	size_t i = celo_slot((uintptr_t)ptr), n = 0;
+	while (celo_ptr[i] && n < CELO_SLOTS) {
+		i = (i + 1) & (CELO_SLOTS - 1);
+		n++;
+	}
+	if (n < CELO_SLOTS && celo_objects < CELO_SLOTS - 1024) {
+		celo_ptr[i] = (uintptr_t)ptr;
+		celo_size[i] = (uint32_t)size;
+		celo_type[i] = (uint8_t)type;
+		celo_site_of[i] = (uintptr_t)(vgl_celo_site ? vgl_celo_site : site);
+		celo_used[type] += size;
+		celo_objects++;
+		if (type == CELO_SPILL) {
+			celo_spill_count++;
+			celo_spill_total += size;
+			if (celo_used[CELO_SPILL] > celo_spill_peak)
+				celo_spill_peak = celo_used[CELO_SPILL];
+		}
+	} else
+		celo_lost++;
+	celo_release();
+}
+#define celo_note(ptr, size, type) celo_note_at(ptr, size, type, __builtin_return_address(0))
+void vgl_celo_note_spill(void *ptr, size_t size) { celo_note(ptr, size, CELO_SPILL); }
+// Forgets ptr; returns its type (-1: not kept).
+static int celo_forget(void *ptr) {
+	int type = -1;
+	celo_acquire();
+	size_t i = celo_slot((uintptr_t)ptr), n = 0;
+	while (celo_ptr[i] && n < CELO_SLOTS) {
+		if (celo_ptr[i] == (uintptr_t)ptr) {
+			type = celo_type[i];
+			celo_used[type] -= celo_size[i];
+			celo_objects--;
+			if (type == CELO_SPILL)
+				celo_spill_count--;
+			// Backward-shift deletion (linear probing).
+			size_t hole = i, j = i;
+			for (;;) {
+				j = (j + 1) & (CELO_SLOTS - 1);
+				if (!celo_ptr[j])
+					break;
+				size_t home = celo_slot(celo_ptr[j]);
+				if (((j - home) & (CELO_SLOTS - 1)) >= ((j - hole) & (CELO_SLOTS - 1))) {
+					celo_ptr[hole] = celo_ptr[j];
+					celo_size[hole] = celo_size[j];
+					celo_type[hole] = celo_type[j];
+					celo_site_of[hole] = celo_site_of[j];
+					hole = j;
+				}
+			}
+			celo_ptr[hole] = 0;
+			break;
+		}
+		i = (i + 1) & (CELO_SLOTS - 1);
+		n++;
+	}
