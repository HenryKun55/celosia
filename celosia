#!/usr/bin/env bash
# celosia: static recompilation of Shadow of the Colossus.
#
#   ./celosia setup --iso <SotC.iso|.zip>   extract the disc and build everything
#   ./celosia run                           play
#   ./celosia help                          all commands and settings
#
# Settings (environment variables, all optional):
#   CELOSIA_DISC   extracted disc directory          (default: ./disc)
#   CELOSIA_BUILD  build + generated code directory  (default: ./build)
#   CELOSIA_JOBS   parallel compile jobs             (default: CPU count)
#   CELOSIA_MEMCARDS  memory card images              (default: ./memcards)
#   CELOSIA_CMAKE_ARGS  extra arguments for the CMake configure step
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DISC=${CELOSIA_DISC:-$ROOT/disc}
BUILD=${CELOSIA_BUILD:-$ROOT/build}
JOBS=${CELOSIA_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 8)}
CMAKE_DIR=$BUILD/cmake
RUNNER_DIR=$BUILD/runner       # recompiled EE code (generated)
VU1REC_DIR=$BUILD/vu1rec       # recompiled VU1 microcode (generated)
VU1_DUMPS=$BUILD/vu1           # VU1 microcode images seen while playing
WORK=$BUILD/recomp             # recompiler inputs/outputs per stage
CAPTURES=$BUILD/captures       # RAM dumps taken when each module starts
LOGS=$ROOT/logs
MEMCARDS=${CELOSIA_MEMCARDS:-$ROOT/memcards}   # Mcd001.ps2 / Mcd002.ps2 (PCSX2 format)
EDITION_FILE=$BUILD/edition
ISO_FILE=$BUILD/iso-path
USA_BOOT=SCUS_974.72
PAL_BOOT=SCES_533.26
BOOT=
EDITION=
RUNNER=$CMAKE_DIR/ps2xRuntime/ps2EntryRunner
RECOMP=$CMAKE_DIR/ps2xRecomp/ps2_recomp
MODULES="KERNEL MANAGER GAMECORE"   # XFF modules, in load order

say() { printf '\033[1;35m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required ($2)"; }
lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }

check_tools() {
    need cmake "brew install cmake"
    need ninja "brew install ninja"
    need python3 "install Python 3.10+"
    need bsdtar "ships with macOS; on Linux: apt install libarchive-tools"
    need pkg-config "brew install pkg-config"
}

detect_disc() {
    local usa=0 pal=0
    [ -f "$DISC/$USA_BOOT" ] && usa=1
    [ -f "$DISC/$PAL_BOOT" ] && pal=1
    [ "$usa" -eq 0 ] || [ "$pal" -eq 0 ] || die "both USA and PAL boot files found in $DISC"
    if [ "$usa" -eq 1 ]; then
        BOOT=$USA_BOOT
        EDITION=usa
    elif [ "$pal" -eq 1 ]; then
        BOOT=$PAL_BOOT
        EDITION=pal
    else
        die "no supported boot file in $DISC (expected $USA_BOOT or $PAL_BOOT)"
    fi
}

check_disc() {
    detect_disc
    local m
    for m in $MODULES; do
        [ -f "$DISC/$m.XFF" ] || die "$DISC/$m.XFF missing: is this a supported release?"
    done
}

check_build_edition() {
    [ ! -f "$EDITION_FILE" ] || [ "$(<"$EDITION_FILE")" = "$EDITION" ] ||
        die "the current runner was built for $(<"$EDITION_FILE"), but $DISC is $EDITION; run ./celosia setup"
}

cmd_extract() {
    local iso=${1:-}
    local source=$iso
    [ -n "$iso" ] || die "usage: ./celosia extract <SotC.iso|.zip>"
    [ -f "$iso" ] || die "$iso not found"
    if [ -f "$DISC/$USA_BOOT" ] || [ -f "$DISC/$PAL_BOOT" ]; then
        detect_disc
        case $(lower "$iso") in
        *.iso)
            bsdtar -tf "$iso" "$BOOT" >/dev/null 2>&1 ||
                die "$iso does not match the $EDITION disc already extracted in $DISC"
            mkdir -p "$BUILD"
            printf '%s/%s\n' "$(cd "$(dirname "$iso")" && pwd -P)" "$(basename "$iso")" >"$ISO_FILE"
            ;;
        *.zip) say "using the existing $EDITION disc (ZIP not re-extracted)" ;;
        *) die "expected an ISO or ZIP: $iso" ;;
        esac
        say "disc already extracted in $DISC"
        return
    fi
    mkdir -p "$DISC" "$BUILD"
    case $(lower "$iso") in
    *.zip)
        say "unpacking $(basename "$iso")"
        local tmp=$BUILD/iso
        rm -rf "$tmp" && mkdir -p "$tmp"
        (cd "$tmp" && unzip -q "$iso")
        iso=$(find "$tmp" -iname '*.iso' | head -1)
        [ -n "$iso" ] || die "no .iso inside the zip"
        ;;
    esac
    say "extracting $(basename "$iso") to $DISC"
    bsdtar -xf "$iso" -C "$DISC"
    rm -rf "$BUILD/iso"
    check_disc
    case $(lower "$source") in
    *.iso) printf '%s/%s\n' "$(cd "$(dirname "$source")" && pwd -P)" "$(basename "$source")" >"$ISO_FILE" ;;
    esac
}

cmd_configure() {
    say "configuring CMake in $CMAKE_DIR"
    mkdir -p "$RUNNER_DIR" "$VU1REC_DIR" "$LOGS"
    # shellcheck disable=SC2086
    cmake -S "$ROOT/PS2Recomp" -B "$CMAKE_DIR" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DPS2X_BUILD_STUDIO=OFF -DPS2X_BUILD_TEST=OFF -DPS2X_BUILD_ANALYZER=OFF \
        -DPS2X_ENABLE_AGRESSIVE_LOGS=OFF \
        "-DPS2X_RUNNER_DIRS=$RUNNER_DIR;$VU1REC_DIR;$ROOT/game/overrides" \
        ${CELOSIA_CMAKE_ARGS:-} >"$LOGS/configure.log" 2>&1 ||
        { tail -30 "$LOGS/configure.log"; die "CMake configure failed (log: logs/configure.log)"; }
}

build_target() {
    [ -f "$CMAKE_DIR/build.ninja" ] || cmd_configure
    say "building $1"
    cmake --build "$CMAKE_DIR" --target "$1" -j "$JOBS" >"$LOGS/build-$1.log" 2>&1 ||
        { grep -m 20 -E "error|Error" "$LOGS/build-$1.log" || tail -30 "$LOGS/build-$1.log"; die "build of $1 failed (log: logs/build-$1.log)"; }
}

# Recompiles a stage directory (config.toml + functions.csv) into the runner.
recompile() {
    local dir=$1
    build_target ps2_recomp
    say "recompiling $(basename "$dir")"
    rm -rf "$dir/output"
    (cd "$dir" && "$RECOMP" config.toml >recomp.log 2>&1) ||
        { tail -20 "$dir/recomp.log"; die "recompiler failed (log: $dir/recomp.log)"; }
    find "$RUNNER_DIR" -maxdepth 1 -type f \( -name '*.cpp' -o -name '*.h' \) -delete
    find "$dir/output" -maxdepth 1 -type f \( -name '*.cpp' -o -name '*.h' \) -exec sh -c 'cp "$@" "$0"' "$RUNNER_DIR" {} +
    # New/removed files change the source glob.
    cmake "$CMAKE_DIR" >"$LOGS/configure.log" 2>&1
    build_target ps2EntryRunner
}

# Stage 0: only the boot ELF (SCUS) is recompiled.
stage_boot() {
    local dir=$WORK/scus
    mkdir -p "$dir"
    say "mapping $BOOT"
    (cd "$ROOT/tools" && python3 - "$DISC/KERNEL.XFF" "$WORK/scus_symbols.txt" <<'EOF'
import sys
from xff import Xff, SHN_ABS
# KERNEL.XFF imports the boot ELF's runtime by absolute address: free symbols.
x = Xff(sys.argv[1])
syms = sorted({(s.value, s.name) for s in x.symbols if s.shndx == SHN_ABS and s.name})
with open(sys.argv[2], "w") as f:
    for v, n in syms:
        f.write(f"{v:08x} {n}\n")
EOF
    )
    python3 "$ROOT/tools/funcmap_elf.py" "$DISC/$BOOT" "$WORK/scus_symbols.txt" "$dir/functions.csv" >/dev/null
    sed "s|^input = .*|input = \"$DISC/$BOOT\"|" "$ROOT/game/scus.toml" >"$dir/config.toml"
    recompile "$dir"
}

# Builds the combined ELF from every captured module, then recompiles it.
stage_game() {
    local dir=$WORK/game specs=() m
    mkdir -p "$dir"
    for m in $MODULES; do
        local dump=$CAPTURES/$(lower "$m").bin
        [ -f "$dump" ] && specs+=("$DISC/$m.XFF@auto@$dump")
    done
    say "linking SOTC.elf from ${#specs[@]} captured module(s)"
    (cd "$ROOT/tools" &&
        python3 build_elf.py "$dir" "$DISC/$BOOT" "$WORK/scus_symbols.txt" "${specs[@]}" &&
        python3 gen_config.py "$dir" "$WORK/scus/config.toml") >"$LOGS/link.log" 2>&1 ||
        { tail -20 "$LOGS/link.log"; die "linking failed (log: logs/link.log)"; }
    recompile "$dir"
}

# The PAL modules use a stable layout. Build a linked recompilation image from
# the user's extracted files instead of bootstrapping it through RAM captures.
# The linker/profile are adapted from LightVelox/sotc-vibe-pc; see
# tools/pal/README.md for source and license details.
stage_pal() {
    local dir=$WORK/pal link=$WORK/pal/link
    mkdir -p "$dir"
    say "linking PAL SCES-53326 v1.00 modules"
    python3 "$ROOT/tools/pal/sotc_link.py" \
        --profile "$ROOT/game/pal/SCES-53326_v1.00.json" \
        --files "$DISC" --out "$link" >"$LOGS/link-pal.log" 2>&1 ||
        { tail -20 "$LOGS/link-pal.log"; die "PAL linking failed (log: logs/link-pal.log)"; }
    cp "$ROOT/game/pal/sces.toml" "$dir/config.toml"
    recompile "$dir"
}

# Runs the game until it jumps into code that is not recompiled yet (the next
# module's entry) and saves guest RAM at that moment.
capture() {
    local name=$1 out=$CAPTURES/$(lower "$1").bin pid i
    mkdir -p "$CAPTURES"
    rm -f "$out"
    say "capturing $name (the game window opens briefly)"
    (cd "$ROOT" && PS2X_DUMP_RAM_ON_MISSING=$out exec "$RUNNER" "$DISC/$BOOT") >"$LOGS/capture-$(lower "$name").log" 2>&1 &
    pid=$!
    for i in $(seq 240); do
        if [ -f "$out" ] && [ "$(wc -c <"$out")" -ge 33554432 ]; then break; fi
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
    done
    sleep 1
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    [ -f "$out" ] && [ "$(wc -c <"$out")" -ge 33554432 ] ||
        die "$name was never reached (log: logs/capture-$(lower "$name").log)"
}

cmd_setup() {
    local iso=""
    while [ $# -gt 0 ]; do
        case $1 in
        --iso) iso=${2:-}; shift 2 ;;
        *) die "unknown option $1" ;;
        esac
    done
    check_tools
    if [ -n "$iso" ]; then cmd_extract "$iso"; fi
    check_disc
    cmd_configure
    if [ "$EDITION" = pal ]; then
        stage_pal
        printf '%s\n' "$EDITION" >"$EDITION_FILE"
        say "PAL build complete (experimental; native USA renderer overrides stay disabled)"
        say "run with: ./celosia run"
        return
    fi
    rm -rf "$CAPTURES"   # every capture depends on the stage before it
    stage_boot
    local m
    for m in $MODULES; do
        capture "$m"
        stage_game
    done
    cmd_vu1
    printf '%s\n' "$EDITION" >"$EDITION_FILE"
    say "done. Play with: ./celosia run"
}

# Compiles the VU1 microcode images collected in $VU1_DUMPS into C++.
cmd_vu1() {
    check_disc
    check_build_edition
    if [ -z "$(ls "$VU1_DUMPS"/*.bin 2>/dev/null)" ]; then
        say "collecting VU1 microcode (40s scripted run)"
        cmd_autotest 40 >/dev/null
    fi
    say "recompiling VU1 microcode"
    mkdir -p "$VU1REC_DIR"
    (cd "$ROOT" && PS2X_VU1_GEN=$VU1_DUMPS:$VU1REC_DIR "$RUNNER" "$DISC/$BOOT") 2>&1 | grep vu1rec || true
    cmake "$CMAKE_DIR" >"$LOGS/configure.log" 2>&1
    build_target ps2EntryRunner
}

cmd_build() {
    check_disc
    check_build_edition
    local stage=game
    [ "$EDITION" = pal ] && stage=pal
    [ -d "$WORK/$stage" ] || die "nothing to build yet (run: ./celosia setup)"
    cmake "$CMAKE_DIR" >"$LOGS/configure.log" 2>&1
    build_target ps2EntryRunner
    printf '%s\n' "$EDITION" >"$EDITION_FILE"
}

cmd_recompile() {
    check_disc
    if [ "$EDITION" = pal ]; then
        [ -d "$WORK/pal" ] || die "nothing to recompile yet (run: ./celosia setup)"
        stage_pal
    else
        [ -d "$WORK/game" ] || die "nothing to recompile yet (run: ./celosia setup)"
        stage_game
    fi
    printf '%s\n' "$EDITION" >"$EDITION_FILE"
}

cmd_run() {
    [ -x "$RUNNER" ] || die "not built yet (run: ./celosia setup --iso <path>)"
    check_disc
    check_build_edition
    mkdir -p "$LOGS" "$VU1_DUMPS"
    say "playing (log: logs/play.log)"
    printf '[celosia] edition=%s boot=%s utc=%s\n' "$EDITION" "$BOOT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$LOGS/play.log"
    cd "$ROOT"
    local pal_diagnostics= cd_image=
    if [ "$EDITION" = pal ]; then
        pal_diagnostics=1
        [ -f "$ISO_FILE" ] || die "PAL sector reads need the ISO path; run ./celosia extract <your PAL ISO>"
        cd_image=$(<"$ISO_FILE")
        [ -f "$cd_image" ] || die "PAL ISO no longer found at $cd_image; run ./celosia extract <your PAL ISO>"
    fi
    PS2X_CD_IMAGE=$cd_image PS2X_PAL_DIAGNOSTICS=$pal_diagnostics PS2X_MEMCARD_DIR=$MEMCARDS PS2X_VU1_DUMP_MISSING=${PS2X_VU1_DUMP_MISSING:-$VU1_DUMPS} exec "$RUNNER" "$DISC/$BOOT" "$@" >>"$LOGS/play.log" 2>&1
}

cmd_diagnose() {
    [ -f "$LOGS/play.log" ] || die "no run log yet (run: ./celosia run)"
    say "last run diagnostics (full log: logs/play.log)"
    grep -E '^\[celosia\]|^\[main\]|^\[cd-image\]|ELF file loaded|^\[sceCdSearchFile|^\[pal-cd-|^\[pal-threads\]|^\[pal-xff\]|^\[guest-branch:missing-target\]|unimplemented syscall|failed|ERROR' "$LOGS/play.log" | tail -30 || true
    grep -m 1 'sceCdRead unresolved' "$LOGS/play.log" || true
}

# Scripted run that saves screenshots: ./celosia autotest [seconds] [interval]
cmd_autotest() {
    local secs=${1:-40} pid pal_diagnostics= cd_image=
    [ -x "$RUNNER" ] || die "not built yet"
    check_disc
    check_build_edition
    if [ "$EDITION" = pal ]; then
        pal_diagnostics=1
        [ -f "$ISO_FILE" ] || die "PAL sector reads need the ISO path; run ./celosia extract <your PAL ISO>"
        cd_image=$(<"$ISO_FILE")
        [ -f "$cd_image" ] || die "PAL ISO no longer found at $cd_image; run ./celosia extract <your PAL ISO>"
    fi
    mkdir -p "$LOGS" "$VU1_DUMPS"
    rm -rf "$ROOT/shots/run" && mkdir -p "$ROOT/shots/run"
    (cd "$ROOT" &&
        PS2X_INPUT_SCRIPT=${PS2X_INPUT_SCRIPT:-"11:DOWN:0.3;12:CROSS:0.3"} \
        PS2X_SNAPSHOT_DIR=shots/run PS2X_SNAPSHOT_SECONDS=${2:-5} \
        PS2X_PAL_DIAGNOSTICS=$pal_diagnostics \
        PS2X_CD_IMAGE=$cd_image \
        PS2X_VU1_DUMP_MISSING=$VU1_DUMPS PS2X_MEMCARD_DIR=${PS2X_MEMCARD_DIR:-$BUILD/autotest-memcards} \
        exec "$RUNNER" "$DISC/$BOOT") >"$LOGS/autotest.log" 2>&1 &
    pid=$!
    # Up to $secs: a run with PS2X_EXIT_AT_FRAME ends on its own sooner.
    local waited=0
    while [ "$waited" -lt "$secs" ] && kill -0 "$pid" 2>/dev/null; do
        sleep 1
        waited=$((waited + 1))
    done
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    echo "$(ls "$ROOT/shots/run" | wc -l | tr -d ' ') screenshots in shots/run, log: logs/autotest.log"
}

cmd_clean() {
    say "removing $BUILD"
    rm -rf "$BUILD"
}

# PS Vita build: ./celosia vita -> build/vita/ps2xRuntime/ps2EntryRunner.vpk
# Install the VPK, then copy disc/ to ux0:data/celosia/disc/.
cmd_vita() {
    check_disc
    check_build_edition
    [ "$EDITION" = usa ] || die "the PAL build path is currently supported on macOS only"
    local VITAGL_REV=464876a
    export VITASDK=${VITASDK:-$HOME/vitasdk}
    [ -f "$VITASDK/share/vita.toolchain.cmake" ] || die "VitaSDK not found (set VITASDK)"
    [ -n "$(find "$RUNNER_DIR" -maxdepth 1 -name '*.cpp' -print -quit 2>/dev/null)" ] || die "no recompiled code yet (run: ./celosia setup)"
    local dir=$BUILD/vita
    # vitaGL built for this port: Z buffers kept across scenes (the GPU GS
    # renderer switches render targets mid-frame), at a pinned revision with
    # our patches. Rebuilt when the revision or the patches change.
    local vgl=$BUILD/vitagl-src
    local vglPatch=$ROOT/PS2Recomp/ps2xRuntime/platform/vita/vitagl/celosia.patch
    local vglStamp="$VITAGL_REV sharklog nosplash $(shasum "$vglPatch" | cut -d' ' -f1)"
    if [ ! -f "$vgl/libvitaGL.a" ] || [ "$(cat "$vgl/.celosia-stamp" 2>/dev/null)" != "$vglStamp" ]; then
        say "building vitaGL ($VITAGL_REV)"
        [ -d "$vgl/.git" ] || git clone -q https://github.com/Rinnegatamante/vitaGL "$vgl" || die "could not clone vitaGL"
        git -C "$vgl" checkout -q -f "$VITAGL_REV" || die "vitaGL revision $VITAGL_REV not found"
        git -C "$vgl" apply "$vglPatch" || die "could not apply $vglPatch"
        PATH="$VITASDK/bin:$PATH" make -C "$vgl" clean >/dev/null 2>&1
        PATH="$VITASDK/bin:$PATH" make -C "$vgl" -j "$JOBS" NO_DEBUG=1 STORE_DEPTH_STENCIL=1 HAVE_SHARK_LOG=1 NO_SPLASHSCREEN=1 >"$LOGS/vitagl-build.log" 2>&1 ||
            { tail -20 "$LOGS/vitagl-build.log"; die "vitaGL build failed (log: logs/vitagl-build.log)"; }
        echo "$vglStamp" >"$vgl/.celosia-stamp"
    fi
    say "configuring the Vita build in $dir"
    cmake -S "$ROOT/PS2Recomp" -B "$dir" -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake" \
        -DCMAKE_BUILD_TYPE=Release \
        -DPS2X_BUILD_RECOMP=OFF -DPS2X_BUILD_STUDIO=OFF -DPS2X_BUILD_TEST=OFF -DPS2X_BUILD_ANALYZER=OFF \
        -DPS2X_ENABLE_AGRESSIVE_LOGS=OFF -DPS2X_ENABLE_FFMPEG=OFF -DPS2X_ENABLE_DEBUG_UI=OFF \
        -DPS2X_ENABLE_RUNNER_PCH=OFF \
        "-DPS2X_RUNNER_DIRS=$RUNNER_DIR;$VU1REC_DIR;$ROOT/game/overrides" \
        "-DPS2X_VITA_APP_NAME=Shadow of the Colossus" -DPS2X_VITA_TITLEID=CELO00001 \
        -DPS2X_DEFAULT_BOOT_ELF=ux0:data/celosia/disc/$BOOT \
        "-DPS2X_VITA_VITAGL_DIR=$vgl" \
        ${CELOSIA_VITA_CMAKE_ARGS:-} >"$LOGS/vita-configure.log" 2>&1 ||
        { tail -30 "$LOGS/vita-configure.log"; die "Vita configure failed (log: logs/vita-configure.log)"; }
    say "building the Vita VPK (this takes a while)"
    cmake --build "$dir" --target ps2EntryRunner.vpk-vpk -j "$JOBS" >"$LOGS/vita-build.log" 2>&1 ||
        { grep -m 20 -E "error|Error" "$LOGS/vita-build.log" || tail -30 "$LOGS/vita-build.log"; die "Vita build failed (log: logs/vita-build.log)"; }
    say "VPK: $dir/ps2xRuntime/ps2EntryRunner.vpk"
}

cmd_help() {
    sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    cat <<'EOF'

Commands:
  setup [--iso PATH]   extract the disc (if given) and run the whole pipeline
  extract PATH         only extract an ISO (or a zip containing one)
  run [args]           play (new VU1 microcode is saved for `vu1`)
  diagnose             summarize the last run's boot and PAL module diagnostics
  vu1                  recompile collected VU1 microcode and rebuild
  recompile            relink modules + recompile game code + rebuild
  build                rebuild the runner (after editing PS2Recomp sources)
  autotest [s] [int]   scripted run with periodic screenshots in shots/run
  vita                 build the PS Vita VPK (build/vita/ps2xRuntime/ps2EntryRunner.vpk)
  clean                delete the build directory
EOF
}

case ${1:-help} in
setup) shift; cmd_setup "$@" ;;
extract) shift; cmd_extract "$@" ;;
configure) cmd_configure ;;
run) shift; cmd_run "$@" ;;
diagnose) cmd_diagnose ;;
vu1) cmd_vu1 ;;
recompile) cmd_recompile ;;
build) cmd_build ;;
autotest) shift; cmd_autotest "$@" ;;
vita) cmd_vita ;;
clean) cmd_clean ;;
help | -h | --help) cmd_help ;;
*) die "unknown command '$1' (see ./celosia help)" ;;
esac
